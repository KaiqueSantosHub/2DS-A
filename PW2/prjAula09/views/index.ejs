<!DOCTYPE html>

<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel de Atendimento</title>


<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/style.css">


</head>
<body>

<main class="dashboard">

    <div class="topo">
        <div class="card-senha">
            <h3>Sua Senha</h3>
            <div class="senha-cliente">
                <%= senha %>
            </div>
        </div>
    </div>

    <section class="painel-principal">
        <span class="legenda">ATENDIMENTO ATUAL</span>

        <div class="senha-display">
            <%= senhaAtual %>
        </div>
    </section>

    <% if(mensagem){ %>
        <div class="mensagem">
            <%= mensagem %>
        </div>
    <% } %>

    <div class="acoes-grid">

        <button
            class="btn-retirar"
            onclick="location.href='/guiche2'">
            Retirar Senha
        </button>

        <button
            class="btn-verificar"
            onclick="location.href='/verificar'">
            Verificar Situação
        </button>

        <button
            class="btn-proximo"
            onclick="location.href='/guiche'">
            Próximo Atendimento
        </button>

    </div>

</main>

</body>
</html>
